# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Telegram notifications to the managers.
# Bot token from @BotFather, and the chat id of the managers' group
# (sign in as a manager and open /api/telegram/chats to read it).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Nightly summary (11 PM Riyadh) — Supabase → Project Settings → API Keys → Secret key.
# Server-only; never put it in the repository.
SUPABASE_SECRET_KEY=
# Optional: protects the nightly job from being triggered by anyone else.
CRON_SECRET=
